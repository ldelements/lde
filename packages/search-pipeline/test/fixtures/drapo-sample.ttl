@prefix schema: <https://schema.org/> .

# A Drapo-shaped SCHEMA-AP-NDE sample: CreativeWork roots typed in the source
# (so selectByClass selects them), each with localized name/description and a
# labelOnly creator reference resolving a typed Person. The blank-node
# CreativeWork mirrors Drapo’s blank-node instances: it has no stable document
# key, so selectByClass must never select it as a root.

<https://ex/cw/1> a schema:CreativeWork ;
  schema:name "Het meisje met de parel"@nl, "Girl with a Pearl Earring"@en ;
  schema:description "Een schilderij van Johannes Vermeer."@nl ;
  schema:creator <https://ex/p/1> .

<https://ex/cw/2> a schema:CreativeWork ;
  schema:name "De nachtwacht"@nl .

_:anonymousWork a schema:CreativeWork ;
  schema:name "Naamloos werk"@nl .

<https://ex/p/1> a schema:Person ;
  schema:name "Johannes Vermeer" .

# A qualified relation, typed apart from the CreativeWork roots above so it is
# selected on its own: the work points at a Role carrying a value of its own and
# the agent behind it. One agent is IRI-identified and described in this graph,
# the other named inline with no IRI at all – the two populations a `local`
# lookup exists to serve with one field.
<https://ex/va/1> a schema:VisualArtwork ;
  schema:name "Winterlandschap"@nl ;
  schema:creator [ a schema:Role ;
                   schema:roleName "etser" ;
                   schema:creator <https://ex/p/1> ] ,
                 [ a schema:Role ;
                   schema:roleName "uitgever" ;
                   schema:creator [ schema:name "Onbekende drukker"@nl ] ] .

# The same relation where the publisher may leave the Role out: one agent in a
# Role, one stated flat, aligned to an authority record it must be keyed on, and
# one Role naming no agent at all.
<https://ex/ph/1> a schema:Photograph ;
  schema:name "Maasgezicht"@nl ;
  schema:contributor [ a schema:Role ;
                       schema:roleName "drukker" ;
                       schema:contributor <https://ex/p/1> ] ,
                     <https://ex/o/1> ,
                     <https://ex/o/2> ,
                     [ a schema:Role ;
                       schema:roleName "fabrikant" ] .

<https://ex/o/1> a schema:Organization ;
  schema:name "Société Céramique" ;
  schema:sameAs <https://rkd.example/104628> .

# A value the publisher may state bare or on a node: SCHEMA-AP-NDE allows each
# identifier to be a string or a PropertyValue, and one work may carry both.
<https://ex/sc/1> a schema:Sculpture ;
  schema:name "Borstbeeld"@nl ;
  schema:identifier "G11125-19" ,
                    [ a schema:PropertyValue ;
                      schema:propertyID <https://data.axiell.com/vocabulary#Priref> ;
                      schema:value "12042" ] .

# A size stated bare is display text no QuantitativeValue node carries, so it
# lands in a literal field with no path – tagged or not.
<https://ex/dr/1> a schema:Drawing ;
  schema:name "Studie"@nl ;
  schema:size "74 cm hoog bij 92 cm breed"@nl ,
              "groot" ,
              [ a schema:QuantitativeValue ;
                schema:value 74 ] .
