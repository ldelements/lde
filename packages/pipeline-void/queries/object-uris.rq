PREFIX void: <http://rdfs.org/ns/void#>
PREFIX void-ext: <http://ldf.fi/void-ext#>

CONSTRUCT {
    ?dataset a void:Dataset ;
        void-ext:distinctIRIReferenceObjects ?distinctIRIReferenceObjects .
}
WHERE {
    # Count groups instead of COUNT(DISTINCT): QLever then needs far less memory,
    # and Fuseki and Virtuoso are as fast.
    SELECT (COUNT(*) AS ?distinctIRIReferenceObjects) {
        SELECT ?o {
            #subjectFilter#
            ?s ?p ?o .
            FILTER(ISIRI(?o))
        }
        GROUP BY ?o
    }
}
