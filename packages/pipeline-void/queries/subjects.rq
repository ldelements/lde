PREFIX void: <http://rdfs.org/ns/void#>

CONSTRUCT {
    ?dataset a void:Dataset ;
        void:distinctSubjects ?count .
}
WHERE {
    # Count groups instead of COUNT(DISTINCT): QLever then needs far less memory,
    # Virtuoso half the time, and Fuseki is as fast.
    SELECT (COUNT(*) AS ?count) {
        SELECT ?s {
            #subjectFilter#
            ?s ?p ?o .
            FILTER(!ISBLANK(?s))
        }
        GROUP BY ?s
    }
}
