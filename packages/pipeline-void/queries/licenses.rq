PREFIX schema: <http://schema.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
PREFIX void: <http://rdfs.org/ns/void#>

CONSTRUCT {
    ?dataset a void:Dataset ;
        void:subset ?licenseSubset .
    ?licenseSubset
        dcterms:license ?license ;
        void:triples ?count .
}
WHERE {
    {
        SELECT ?license (COUNT(*) AS ?count) {
            #subjectFilter#
            ?s ?p ?license .
            # dcterms:license is the Dublin Core (and DCAT) license property;
            # Dublin Core Elements 1.1 has no license element.
            VALUES ?p { schema:license <https://schema.org/license> dcterms:license rico:conditionsOfUse }
            # Licenses must be IRIs: casting a text literal such as “CC0 1.0”
            # with IRI() would yield an invalid IRI that fails serialisation.
            FILTER(isIRI(?license))
        }
        GROUP BY ?license
    }
    BIND(URI(CONCAT(STR(?dataset), "/.well-known/void#license-", MD5(STR(?license)))) AS ?licenseSubset)
}
