PREFIX void: <http://rdfs.org/ns/void#>
PREFIX void-ext: <http://ldf.fi/void-ext#>

CONSTRUCT {
    ?dataset a void:Dataset ;
        void-ext:distinctLiterals ?distinctLiterals .
}
WHERE {
    # Count groups instead of COUNT(DISTINCT): QLever then needs far less memory,
    # and Fuseki and Virtuoso are as fast. A DISTINCT subquery ran Fuseki out of memory.
    SELECT (COUNT(*) AS ?distinctLiterals) {
        SELECT ?o {
            #subjectFilter#
            ?s ?p ?o .
            FILTER(ISLITERAL(?o))
        }
        GROUP BY ?o
    }
}
