PREFIX void: <http://rdfs.org/ns/void#>

CONSTRUCT {
    ?dataset a void:Dataset ;
        void:subset ?subset .
    ?subset void:uriSpace ?uriSpace ;
        void:entities ?count .
}
WHERE {
    {
        SELECT ?uriSpace (SUM(?groupCount) AS ?count) {
            {
                # Group subjects by the directory of their document (the IRI without fragment),
                # keeping hash IRIs apart. MIN = MAX tells whether a hash group holds a single
                # document, without the cost of COUNT(DISTINCT ?document).
                SELECT ?directory ?isHash (COUNT(*) AS ?groupCount)
                    (MIN(?document) AS ?firstDocument) (MAX(?document) AS ?lastDocument) {
                    {
                        # Pre-group distinct subjects before computing namespace to avoid regex on every triple.
                        SELECT DISTINCT ?s {
                            #subjectFilter#
                            ?s ?p ?o .
                            FILTER(ISIRI(?s))
                        }
                    }
                    BIND(STR(?s) AS ?iri)
                    BIND(CONTAINS(?iri, "#") AS ?isHash)
                    BIND(IF(?isHash, STRBEFORE(?iri, "#"), ?iri) AS ?document)
                    BIND(REPLACE(?document, "[^/]*$", "") AS ?prefix)
                    # A document without path (http://host, urn:…) is its own directory.
                    BIND(IF(?prefix = "" || STRENDS(?prefix, "//"), ?document, ?prefix) AS ?directory)
                }
                GROUP BY ?directory ?isHash
            }
            # A hash vocabulary (…/skos/core#) keeps its document as namespace; hash IRIs spread
            # over several documents (…/record1#media, …/record2#media) share their directory.
            BIND(IF(?isHash && ?firstDocument = ?lastDocument, CONCAT(?firstDocument, "#"), ?directory) AS ?uriSpace)
        }
        GROUP BY ?uriSpace
        ORDER BY DESC(?count)
        LIMIT 10
    }
    FILTER(?count > 1)  # Only include namespaces with more than 1 entity
    BIND(URI(CONCAT(STR(?dataset), "/.well-known/void#subject-uri-space-", MD5(?uriSpace))) AS ?subset)
}

