PREFIX void: <http://rdfs.org/ns/void#>

CONSTRUCT {
    ?dataset a void:Dataset ;
        void:subset ?subset .
    ?subset void:uriSpace ?uriSpace ;
        void:entities ?count .
}
WHERE {
    {
        SELECT ?uriSpace (SUM(?groupCount) AS ?count) {
            {
                # Group the keys by directory, keeping hash IRIs apart. The number of keys in a
                # hash group is the number of documents it holds.
                SELECT ?directory ?isHash (SUM(?keyCount) AS ?groupCount)
                    (COUNT(*) AS ?documents) (MIN(?key) AS ?firstKey) {
                    {
                        # Reduce each distinct subject to one key with a single REPLACE: its
                        # document followed by "#" for a hash IRI, its directory otherwise.
                        # Grouping on that key first keeps the per-subject strings to one. The
                        # pattern uses + rather than *, because Virtuoso rejects a pattern that
                        # matches the empty string; an IRI ending in / is its own key either way.
                        SELECT ?key (COUNT(*) AS ?keyCount) {
                            {
                                SELECT DISTINCT ?s {
                                    #subjectFilter#
                                    ?s ?p ?o .
                                    FILTER(ISIRI(?s))
                                }
                            }
                            BIND(REPLACE(STR(?s), "(#).*$|[^/#]+$", "$1") AS ?key)
                        }
                        GROUP BY ?key
                    }
                    BIND(STRENDS(?key, "#") AS ?isHash)
                    BIND(IF(?isHash, REPLACE(?key, "[^/]*#$", ""), ?key) AS ?prefix)
                    # A subject without hash and without path (http://host, urn:…) is a URI
                    # space of its own with one entity, which the count filter below drops.
                    FILTER(?isHash || (?prefix != "" && !STRENDS(?prefix, "//")))
                    # A hash document without path is its own directory.
                    BIND(IF(?prefix = "" || STRENDS(?prefix, "//"), STRBEFORE(?key, "#"), ?prefix) AS ?directory)
                }
                GROUP BY ?directory ?isHash
            }
            # A hash vocabulary (…/skos/core#) keeps its document as namespace; hash IRIs spread
            # over several documents (…/record1#media, …/record2#media) share their directory.
            BIND(IF(?isHash && ?documents = 1, ?firstKey, ?directory) AS ?uriSpace)
        }
        GROUP BY ?uriSpace
        ORDER BY DESC(?count)
        LIMIT 10
    }
    FILTER(?count > 1)  # Only include namespaces with more than 1 entity
    BIND(URI(CONCAT(STR(?dataset), "/.well-known/void#subject-uri-space-", MD5(?uriSpace))) AS ?subset)
}
