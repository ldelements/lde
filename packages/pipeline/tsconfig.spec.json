{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "rootDir": "."
  },
  "include": [
    "vitest.config.ts",
    "test/**/*.ts",
    "test/**/*.test.tsx",
    "test/**/*.spec.tsx",
    "test/**/*.test.js",
    "test/**/*.spec.js",
    "test/**/*.test.jsx",
    "test/**/*.spec.jsx"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
