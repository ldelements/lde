{
  "name": "@lde/resolver",
  "version": "0.0.0",
  "description": "Resolve external references with a durable fact store, bounded outbound work, timeouts, retry, failure isolation and a per-run volume cap",
  "repository": {
    "url": "git+https://github.com/ldelements/lde.git",
    "directory": "packages/resolver"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@lde/host-limiter": "^0.0.0",
    "tslib": "^2.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
