{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": [
    "test/**/*.test.ts",
    "test/**/*.spec.ts",
    "test/**/*.test.tsx",
    "test/**/*.spec.tsx",
    "test/**/*.test.js",
    "test/**/*.spec.js",
    "test/**/*.test.jsx",
    "test/**/*.spec.jsx",
    "test/**/*.d.ts",
    "agent/**/*.ts",
    "package.json"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
