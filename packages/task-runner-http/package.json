{
  "name": "@lde/task-runner-http",
  "version": "0.1.0",
  "description": "Run tasks in another container of the same pod, such as a sidecar with its own memory limit, through a task agent on 127.0.0.1.",
  "repository": {
    "url": "git+https://github.com/ldelements/lde.git",
    "directory": "packages/task-runner-http"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@lde/task-runner": "^0.3.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@lde/task-runner-native": "^0.3.0",
    "commander": "^15.0.0",
    "fastify": "^5.12.7"
  },
  "nx": {
    "targets": {
      "bundle-agent": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist-agent"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "rolldown -c agent/rolldown.config.mjs"
        },
        "dependsOn": [
          "^build"
        ]
      },
      "docker:build": {
        "dependsOn": [
          "bundle-agent"
        ]
      },
      "docker:smoke": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "docker:build"
        ],
        "cache": false,
        "options": {
          "command": "./tools/docker-smoke-task-agent.sh packages-task-runner-http"
        }
      }
    }
  }
}
